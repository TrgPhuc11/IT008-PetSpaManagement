<UserControl x:Class="SpaThuCung.Views.KhachHangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="NutChinh" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="{StaticResource MauNhan}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauNhan}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedForeground" Value="White" />
        </Style>
        <Style x:Key="NutPhu" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource MauNutPhu}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauChon}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauChon}" />
            <Setter Property="PressedForeground" Value="{StaticResource MauChu}" />
        </Style>

        <Style x:Key="ChuODuLieu" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
        </Style>
        <Style x:Key="ChuODuLieuSo" TargetType="TextBlock" BasedOn="{StaticResource ChuODuLieu}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Nhãn của ô nhập trong form -->
        <Style x:Key="NhanO" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,12,0,6" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
        </Style>

        <!-- Nhãn tròn (cảnh báo, tiêm phòng) -->
        <Style x:Key="Nhan" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Khách hàng" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource MauChu}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,16" FontSize="14" TextWrapping="Wrap"
                   Foreground="{StaticResource MauChuPhu}"
                   Text="Mỗi khách có một hồ sơ theo số điện thoại (không trùng). Số lần không đến tính theo số phiếu Không đến; đạt ngưỡng trong Cấu hình thì khách bị gắn cờ cảnh báo (chỉ cảnh báo, không chặn đặt lịch)." />

        <!-- Thanh công cụ -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,0,0,8">
            <ui:TextBox DockPanel.Dock="Left" Width="300" Margin="0,0,8,0"
                        PlaceholderText="Tìm theo tên hoặc SĐT"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding TuKhoa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button DockPanel.Dock="Left" Content="Thêm khách" Margin="0,0,8,0" Style="{StaticResource NutChinh}"
                       Icon="{ui:SymbolIcon PersonAdd24}"
                       Command="{Binding ThemCommand}" />
            <ui:Button DockPanel.Dock="Left" Content="Sửa" Style="{StaticResource NutPhu}"
                       Command="{Binding SuaCommand}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding TomTat}" FontSize="13" VerticalAlignment="Center"
                       Foreground="{StaticResource MauChuPhu}" />
        </DockPanel>

        <!-- Hộp thông báo: màu đổi theo LoaiThongBao (mặc định là lỗi) -->
        <Border Grid.Row="3" Margin="0,0,0,12" Padding="12,8" CornerRadius="4"
                Visibility="{Binding CoThongBao, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource MauLoiNen}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                            <Setter Property="Background" Value="{StaticResource MauOkNen}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                            <Setter Property="Background" Value="{StaticResource MauCanhBaoNen}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ThongBao}" FontSize="13" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MauLoiChu}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                                <Setter Property="Foreground" Value="{StaticResource MauOkChu}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                                <Setter Property="Foreground" Value="{StaticResource MauCanhBaoChu}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Bảng + panel bên phải -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource MauThe}"
                    BorderBrush="{StaticResource MauVienBang}" BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding DanhSach}"
                          SelectedItem="{Binding KhachDuocChon, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource MauVienBang}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          RowHeight="40"
                          Margin="4"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Width="80"
                                            Binding="{Binding MaHienThi, Mode=OneWay}"
                                            ElementStyle="{StaticResource ChuODuLieu}" />
                        <DataGridTextColumn Header="Họ tên" Width="*" MinWidth="140"
                                            Binding="{Binding HoTen, Mode=OneWay}"
                                            ElementStyle="{StaticResource ChuODuLieu}" />
                        <DataGridTextColumn Header="SĐT" Width="120"
                                            Binding="{Binding Sdt, Mode=OneWay}"
                                            ElementStyle="{StaticResource ChuODuLieu}" />
                        <DataGridTextColumn Header="Thú cưng" Width="90"
                                            Binding="{Binding SoThuCung, Mode=OneWay}"
                                            ElementStyle="{StaticResource ChuODuLieuSo}" />
                        <DataGridTextColumn Header="Không đến" Width="95"
                                            Binding="{Binding SoLanKhongDen, Mode=OneWay}"
                                            ElementStyle="{StaticResource ChuODuLieuSo}" />
                        <DataGridTemplateColumn Header="Cảnh báo" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Nhan}" Background="{StaticResource MauLoiNen}"
                                            Visibility="{Binding CoCanhBao, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Hay không đến" FontSize="12" Foreground="{StaticResource MauLoiChu}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ghi chú" Width="*" MinWidth="120"
                                            Binding="{Binding GhiChu, Mode=OneWay}"
                                            ElementStyle="{StaticResource ChuODuLieu}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Form thêm / sửa -->
            <Border Grid.Column="1" Width="300" Margin="16,0,0,0" Padding="16" CornerRadius="8"
                    Background="{StaticResource MauThe}"
                    BorderBrush="{StaticResource MauVienBang}" BorderThickness="1"
                    Visibility="{Binding DangMoForm, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button Content="Huỷ" MinWidth="80" Margin="0,0,8,0" Style="{StaticResource NutPhu}"
                                   Command="{Binding HuyCommand}" />
                        <ui:Button Content="Lưu" MinWidth="80" Style="{StaticResource NutChinh}"
                                   Command="{Binding LuuCommand}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding TieuDeForm}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource MauChu}" />

                            <TextBlock Text="Họ tên *" Style="{StaticResource NhanO}" />
                            <ui:TextBox MaxLength="100" Text="{Binding FormHoTen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Số điện thoại *" Style="{StaticResource NhanO}" />
                            <ui:TextBox MaxLength="15" Text="{Binding FormSdt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Ghi chú" Style="{StaticResource NhanO}" />
                            <ui:TextBox MaxLength="255" MinHeight="72" TextWrapping="Wrap" AcceptsReturn="False"
                                        VerticalContentAlignment="Top"
                                        Text="{Binding FormGhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MauChuPhu}"
                                       Text="SĐT đã có hồ sơ thì hệ thống mở hồ sơ cũ thay vì tạo khách mới." />

                            <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="4"
                                    Background="{StaticResource MauLoiNen}"
                                    Visibility="{Binding CoFormLoi, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding FormLoi}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource MauLoiChu}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Chi tiết khách đang chọn -->
            <Border Grid.Column="1" Width="300" Margin="16,0,0,0" Padding="16" CornerRadius="8"
                    Background="{StaticResource MauThe}"
                    BorderBrush="{StaticResource MauVienBang}" BorderThickness="1"
                    Visibility="{Binding HienChiTiet, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding KhachDuocChon}">
                        <TextBlock Text="{Binding HoTen}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource MauChu}" />
                        <TextBlock FontSize="13" Margin="0,4,0,0" Foreground="{StaticResource MauChuPhu}">
                            <Run Text="{Binding MaHienThi, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Sdt, Mode=OneWay}" />
                        </TextBlock>

                        <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="4" Background="{StaticResource MauLoiNen}"
                                Visibility="{Binding CoCanhBao, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource MauLoiChu}">
                                <Run Text="Cảnh báo: khách đã không đến " /><Run Text="{Binding SoLanKhongDen, Mode=OneWay}" /><Run Text=" lần." />
                            </TextBlock>
                        </Border>
                        <TextBlock FontSize="13" Margin="0,12,0,0" Foreground="{StaticResource MauChu}">
                            <Run Text="Số lần không đến: " /><Run Text="{Binding SoLanKhongDen, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding GhiChu}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource MauChuPhu}" />

                        <TextBlock Text="Thú cưng" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,6"
                                   Foreground="{StaticResource MauChu}" />
                        <ItemsControl ItemsSource="{Binding DataContext.ThuCungCuaKhach, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,6" BorderBrush="{StaticResource MauVienBang}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock FontSize="13" Foreground="{StaticResource MauChu}">
                                                <Run Text="{Binding Ten, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Loai, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CanNangHienThi, Mode=OneWay}" /><Run Text=" kg" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding TiemPhongHienThi}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MauCanhBaoChu}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DaTiemPhong}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource MauOkChu}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Khách chưa có thú cưng. Thêm ở trang Thú cưng." FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource MauChuPhu}"
                                   Visibility="{Binding DataContext.KhachChuaCoThuCung, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
