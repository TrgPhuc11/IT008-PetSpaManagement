<ui:FluentWindow x:Class="SpaThuCung.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Spa thú cưng - Đăng nhập"
                 Width="420" Height="560"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource MauNen}"
                 Foreground="{StaticResource MauChu}"
                 FontFamily="Segoe UI"
                 FocusManager.FocusedElement="{Binding ElementName=TxtTenDangNhap}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Spa thú cưng" ShowMaximize="False" CanMaximize="False" />

        <StackPanel Grid.Row="1" Margin="40,0,40,24" VerticalAlignment="Center">

            <!-- Biểu tượng dấu chân (vẽ bằng hình học, không phụ thuộc bộ icon) -->
            <Viewbox Width="56" Height="56" HorizontalAlignment="Center">
                <Canvas Width="100" Height="100">
                    <Path Fill="{StaticResource MauNhan}">
                        <Path.Data>
                            <GeometryGroup>
                                <EllipseGeometry Center="50,68" RadiusX="26" RadiusY="21" />
                                <EllipseGeometry Center="20,42" RadiusX="9" RadiusY="12" />
                                <EllipseGeometry Center="39,22" RadiusX="9" RadiusY="12" />
                                <EllipseGeometry Center="61,22" RadiusX="9" RadiusY="12" />
                                <EllipseGeometry Center="80,42" RadiusX="9" RadiusY="12" />
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                </Canvas>
            </Viewbox>

            <TextBlock Text="Spa thú cưng" Margin="0,12,0,0"
                       FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource MauChu}" />
            <TextBlock Text="Đăng nhập để bắt đầu ca làm việc" Margin="0,4,0,28"
                       FontSize="14" HorizontalAlignment="Center"
                       Foreground="{StaticResource MauChuPhu}" />

            <TextBlock Text="Tên đăng nhập" Margin="0,0,0,6" FontSize="13"
                       Foreground="{StaticResource MauChu}" />
            <ui:TextBox x:Name="TxtTenDangNhap"
                        PlaceholderText="Nhập tên đăng nhập"
                        Text="{Binding TenDangNhap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Mật khẩu" Margin="0,16,0,6" FontSize="13"
                       Foreground="{StaticResource MauChu}" />
            <ui:PasswordBox PlaceholderText="Nhập mật khẩu"
                            Password="{Binding MatKhau, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Border Margin="0,16,0,0" Padding="12,8" CornerRadius="4"
                    Background="{StaticResource MauLoiNen}"
                    Visibility="{Binding CoThongBaoLoi, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ThongBaoLoi}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource MauLoiChu}" />
            </Border>

            <ui:Button Margin="0,24,0,0" Height="44"
                       HorizontalAlignment="Stretch"
                       Appearance="Primary"
                       Background="{StaticResource MauNhan}"
                       BorderBrush="{StaticResource MauNhan}"
                       Foreground="White"
                       MouseOverBackground="{StaticResource MauNhanDam}"
                       MouseOverBorderBrush="{StaticResource MauNhanDam}"
                       PressedBackground="{StaticResource MauNhanDam}"
                       PressedForeground="White"
                       IsDefault="True"
                       Content="{Binding ChuNutDangNhap}"
                       Command="{Binding DangNhapCommand}" />

            <TextBlock Text="Quên mật khẩu? Nhờ Quản lý đặt lại." Margin="0,20,0,0"
                       FontSize="12" HorizontalAlignment="Center"
                       Foreground="{StaticResource MauChuPhu}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
