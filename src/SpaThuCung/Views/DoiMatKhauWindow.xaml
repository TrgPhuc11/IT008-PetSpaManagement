<ui:FluentWindow x:Class="SpaThuCung.Views.DoiMatKhauWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Đổi mật khẩu"
                 Width="420" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource MauNen}"
                 Foreground="{StaticResource MauChu}"
                 FontFamily="Segoe UI"
                 FocusManager.FocusedElement="{Binding ElementName=TxtHienTai}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="NhanO" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,12,0,6" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Đổi mật khẩu" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,24">
            <TextBlock Text="Đổi mật khẩu" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource MauChu}" />
            <TextBlock Text="{Binding TaiKhoan}" Margin="0,4,0,0" FontSize="14"
                       Foreground="{StaticResource MauChuPhu}" />

            <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource NhanO}" />
            <ui:PasswordBox x:Name="TxtHienTai" IsEnabled="{Binding CoTheNhap}"
                            Password="{Binding MatKhauHienTai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Mật khẩu mới" Style="{StaticResource NhanO}" />
            <ui:PasswordBox IsEnabled="{Binding CoTheNhap}"
                            Password="{Binding MatKhauMoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Ít nhất 6 ký tự, khác mật khẩu hiện tại." Margin="0,6,0,0" FontSize="12"
                       Foreground="{StaticResource MauChuPhu}" />

            <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource NhanO}" />
            <ui:PasswordBox IsEnabled="{Binding CoTheNhap}"
                            Password="{Binding NhapLai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Lỗi -->
            <Border Margin="0,16,0,0" Padding="12,8" CornerRadius="4"
                    Background="{StaticResource MauLoiNen}"
                    Visibility="{Binding CoLoi, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ThongBaoLoi}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource MauLoiChu}" />
            </Border>

            <!-- Thành công -->
            <Border Margin="0,16,0,0" Padding="12,8" CornerRadius="4"
                    Background="{StaticResource MauOkNen}"
                    Visibility="{Binding CoThongBaoOk, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ThongBaoOk}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource MauOkChu}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <ui:Button Content="{Binding ChuNutDong}" Height="36" MinWidth="80" Margin="0,0,8,0"
                           IsCancel="True"
                           Background="{StaticResource MauNutPhu}"
                           BorderBrush="{StaticResource MauVien}"
                           Foreground="{StaticResource MauChu}"
                           MouseOverBackground="{StaticResource MauChon}"
                           MouseOverBorderBrush="{StaticResource MauVien}"
                           PressedBackground="{StaticResource MauChon}"
                           PressedForeground="{StaticResource MauChu}"
                           Command="{Binding DongCommand}" />
                <ui:Button Content="{Binding ChuNutLuu}" Height="36" MinWidth="120"
                           IsDefault="True"
                           Appearance="Primary"
                           Background="{StaticResource MauNhan}"
                           BorderBrush="{StaticResource MauNhan}"
                           Foreground="White"
                           MouseOverBackground="{StaticResource MauNhanDam}"
                           MouseOverBorderBrush="{StaticResource MauNhanDam}"
                           PressedBackground="{StaticResource MauNhanDam}"
                           PressedForeground="White"
                           Visibility="{Binding CoTheNhap, Converter={StaticResource BoolToVis}}"
                           Command="{Binding LuuCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
