<UserControl x:Class="SpaThuCung.Views.CauHinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Nút chính (màu nhấn) và nút phụ, cùng kiểu với các màn khác -->
        <Style x:Key="NutChinh" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="{StaticResource MauNhan}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauNhan}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedForeground" Value="White" />
        </Style>
        <Style x:Key="NutPhu" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource MauNutPhu}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauChon}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauChon}" />
            <Setter Property="PressedForeground" Value="{StaticResource MauChu}" />
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MauThe}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVienBang}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="NhanO" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
        </Style>
        <Style x:Key="ChuPhu" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
        </Style>
        <Style x:Key="ChuLoi" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MauLoiChu}" />
        </Style>

        <Style x:Key="TieuDeCot" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
        </Style>
        <Style x:Key="TieuDeCotSo" TargetType="TextBlock" BasedOn="{StaticResource TieuDeCot}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Chữ trong dòng ca: ca ngừng sử dụng thì xám -->
        <Style x:Key="ChuO" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NgungSuDung}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChuOSo" TargetType="TextBlock" BasedOn="{StaticResource ChuO}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="NhanTrangThai" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource MauOkNen}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NgungSuDung}" Value="True">
                    <Setter Property="Background" Value="{StaticResource MauChon}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChuTrangThai" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MauOkChu}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NgungSuDung}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cấu hình hệ thống" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource MauChu}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,16" FontSize="14" TextWrapping="Wrap"
                   Foreground="{StaticResource MauChuPhu}"
                   Text="Ca làm việc và các thông số vận hành của tiệm. Xếp lịch, phân công Groomer và các cảnh báo dùng giá trị mới ở lần xử lý sau." />

        <!-- Hộp thông báo: màu đổi theo LoaiThongBao (mặc định là lỗi) -->
        <Border Grid.Row="2" Margin="0,0,0,12" Padding="12,8" CornerRadius="4"
                Visibility="{Binding CoThongBao, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource MauLoiNen}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                            <Setter Property="Background" Value="{StaticResource MauOkNen}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                            <Setter Property="Background" Value="{StaticResource MauCanhBaoNen}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ThongBao}" FontSize="13" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MauLoiChu}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                                <Setter Property="Foreground" Value="{StaticResource MauOkChu}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                                <Setter Property="Foreground" Value="{StaticResource MauCanhBaoChu}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0">

            <!-- ================= Thẻ Ca làm việc ================= -->
            <TabItem Header="Ca làm việc">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,0">
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding TomTatCa}" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{StaticResource MauChu}" />
                            <ui:Button DockPanel.Dock="Right" Content="Thêm ca" Style="{StaticResource NutChinh}"
                                       Command="{Binding ThemCaCommand}" />
                        </DockPanel>

                        <!-- Danh sách ca -->
                        <Border Style="{StaticResource The}" Padding="6,8">
                            <StackPanel>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tên ca" Style="{StaticResource TieuDeCot}" />
                                    <TextBlock Grid.Column="1" Text="Giờ" Style="{StaticResource TieuDeCot}" />
                                    <TextBlock Grid.Column="2" Text="Phút / Groomer" Style="{StaticResource TieuDeCotSo}"
                                               ToolTip="Thời lượng ca = giờ kết thúc − giờ bắt đầu, dùng cho cảnh báo quá tải Groomer" />
                                    <TextBlock Grid.Column="3" Text="Được lố" Style="{StaticResource TieuDeCot}" />
                                    <TextBlock Grid.Column="4" Text="Lễ tân" Style="{StaticResource TieuDeCotSo}" />
                                    <TextBlock Grid.Column="5" Text="Groomer" Style="{StaticResource TieuDeCotSo}" />
                                    <TextBlock Grid.Column="6" Text="Trạng thái" Style="{StaticResource TieuDeCot}" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource MauVienBang}" />

                                <ItemsControl ItemsSource="{Binding DanhSachCa}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="110" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="280" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TenCa}" FontWeight="SemiBold" Style="{StaticResource ChuO}" />
                                                <TextBlock Grid.Column="1" Text="{Binding GioHienThi}" Style="{StaticResource ChuO}" />
                                                <TextBlock Grid.Column="2" Text="{Binding ThoiLuongHienThi}" Style="{StaticResource ChuOSo}" />
                                                <TextBlock Grid.Column="3" Text="{Binding LoHienThi}" Style="{StaticResource ChuO}" />
                                                <TextBlock Grid.Column="4" Text="{Binding SoLeTanHienThi}" Style="{StaticResource ChuOSo}" />
                                                <TextBlock Grid.Column="5" Text="{Binding SoGroomerHienThi}" Style="{StaticResource ChuOSo}" />
                                                <Border Grid.Column="6" Style="{StaticResource NhanTrangThai}">
                                                    <TextBlock Text="{Binding TrangThaiHienThi}" Style="{StaticResource ChuTrangThai}" />
                                                </Border>
                                                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                                    <ui:Button Content="Sửa" Height="32" MinWidth="64" Margin="0,0,8,0"
                                                               Style="{StaticResource NutPhu}"
                                                               Command="{Binding DataContext.SuaCaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Content="{Binding NutTrangThai}" Height="32" MinWidth="120" Margin="0,0,8,0"
                                                               Style="{StaticResource NutPhu}"
                                                               Command="{Binding DataContext.DoiTrangThaiCaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Content="Xoá" Height="32" MinWidth="56"
                                                               Style="{StaticResource NutPhu}"
                                                               ToolTip="Chỉ xoá được ca chưa có lịch làm việc"
                                                               Command="{Binding DataContext.XoaCaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Form thêm/sửa ca, mỗi lần một ca -->
                        <Border Style="{StaticResource The}" Margin="0,12,0,0" Padding="16,14"
                                BorderBrush="{StaticResource MauNhan}" BorderThickness="2"
                                Visibility="{Binding DangMoFormCa, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding TieuDeFormCa}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"
                                           Foreground="{StaticResource MauChu}" />
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Width="220" Margin="0,0,12,10">
                                        <TextBlock Text="Tên ca *" Style="{StaticResource NhanO}" />
                                        <ui:TextBox MaxLength="30" PlaceholderText="Ví dụ: Ca sáng"
                                                    Text="{Binding TenCa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,12,10">
                                        <TextBlock Text="Giờ bắt đầu *" Style="{StaticResource NhanO}" />
                                        <ui:TextBox MaxLength="5" PlaceholderText="08:00"
                                                    Text="{Binding GioBatDau, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,12,10">
                                        <TextBlock Text="Giờ kết thúc *" Style="{StaticResource NhanO}" />
                                        <ui:TextBox MaxLength="5" PlaceholderText="14:30"
                                                    Text="{Binding GioKetThuc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,12,10">
                                        <TextBlock Text="Được lố (phút) *" Style="{StaticResource NhanO}" />
                                        <ui:TextBox MaxLength="3"
                                                    Text="{Binding PhutVuot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,12,10">
                                        <TextBlock Text="Số Lễ tân *" Style="{StaticResource NhanO}" />
                                        <ui:TextBox MaxLength="2"
                                                    Text="{Binding SoLeTan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,12,10">
                                        <TextBlock Text="Số Groomer *" Style="{StaticResource NhanO}" />
                                        <ui:TextBox MaxLength="2"
                                                    Text="{Binding SoGroomer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Text="{Binding XemTruocCa}" Style="{StaticResource ChuPhu}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource ChuPhu}"
                                           Text="Các ca đang sử dụng không được chồng giờ nhau. Ca ngừng sử dụng không được chọn khi xếp lịch. Ca đã có lịch làm việc không xoá được, chỉ ngừng sử dụng." />
                                <TextBlock Text="{Binding LoiCa}" Style="{StaticResource ChuLoi}"
                                           Visibility="{Binding CoLoiCa, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ui:Button Content="Lưu" MinWidth="96" Margin="0,0,8,0" Style="{StaticResource NutChinh}"
                                               Command="{Binding LuuCaCommand}" />
                                    <ui:Button Content="Huỷ" MinWidth="96" Style="{StaticResource NutPhu}"
                                               Command="{Binding HuyCaCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Thẻ Thông số ================= -->
            <TabItem Header="Thông số">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource The}" Margin="0,12,0,0" Padding="18,14" MaxWidth="820" HorizontalAlignment="Left">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding CacThongSo}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Ten}" FontSize="14" VerticalAlignment="Top" Margin="0,8,12,0"
                                                       TextWrapping="Wrap" Foreground="{StaticResource MauChu}" />
                                            <StackPanel Grid.Column="1">
                                                <ui:TextBox MaxLength="4" TextAlignment="Right"
                                                            Text="{Binding GiaTri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DonVi}" Margin="8,8,0,0" FontSize="14"
                                                       Foreground="{StaticResource MauChuPhu}" />
                                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding MoTa}" Style="{StaticResource ChuPhu}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Loi}" Style="{StaticResource ChuLoi}"
                                                           Visibility="{Binding CoLoi, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Thư mục ảnh -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Thư mục lưu ảnh thú cưng" FontSize="14" Margin="0,8,12,0"
                                           Foreground="{StaticResource MauChu}" />
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Chọn thư mục" Margin="8,0,0,0"
                                                   Style="{StaticResource NutPhu}" Command="{Binding ChonThuMucCommand}" />
                                        <ui:TextBox MaxLength="100"
                                                    Text="{Binding ThuMucAnh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding ThuMucAnhDayDu}" Style="{StaticResource ChuPhu}" Margin="0,4,0,0" />
                                    <TextBlock Style="{StaticResource ChuPhu}" Margin="0,2,0,0"
                                               Text="Đường dẫn tương đối tính từ thư mục chương trình. Mặc định: HinhAnh. Ảnh đã lưu ở thư mục cũ không tự chuyển sang." />
                                    <TextBlock Text="{Binding LoiThuMuc}" Style="{StaticResource ChuLoi}"
                                               Visibility="{Binding CoLoiThuMuc, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Lưu thông số" MinWidth="120" Margin="0,0,8,0" Style="{StaticResource NutChinh}"
                                           Command="{Binding LuuThongSoCommand}" />
                                <ui:Button Content="Hoàn tác" MinWidth="96" Style="{StaticResource NutPhu}"
                                           Command="{Binding HoanTacThongSoCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
