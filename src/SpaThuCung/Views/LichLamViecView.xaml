<UserControl x:Class="SpaThuCung.Views.LichLamViecView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Màu thẻ theo vị trí (giống mẫu giao diện) -->
        <SolidColorBrush x:Key="MauLeTanNen" Color="#E8EEF6" />
        <SolidColorBrush x:Key="MauGroomerNen" Color="#E6F0DA" />

        <!-- Nút chính (màu nhấn) và nút phụ, cùng kiểu với các màn khác -->
        <Style x:Key="NutChinh" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="{StaticResource MauNhan}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauNhan}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedForeground" Value="White" />
        </Style>
        <Style x:Key="NutPhu" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource MauNutPhu}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauChon}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauChon}" />
            <Setter Property="PressedForeground" Value="{StaticResource MauChu}" />
        </Style>

        <!-- Nút × nhỏ trên thẻ tên -->
        <Style x:Key="NutXoaThe" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Nen" Background="Transparent" CornerRadius="3">
                            <TextBlock Text="×" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Nen" Property="Background" Value="#33000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MauThe}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVienBang}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="NhanO" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,8,0,6" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
        </Style>
        <Style x:Key="ChuPhu" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Lịch làm việc" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource MauChu}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,12" FontSize="14" TextWrapping="Wrap"
                   Foreground="{StaticResource MauChuPhu}"
                   Text="Mỗi nhân viên tối đa một ca, một vị trí mỗi ngày. Số Lễ tân và Groomer của mỗi ca lấy theo Cấu hình hệ thống (mặc định 1 Lễ tân, 2 Groomer). Ngày đã qua không sửa được." />

        <!-- Thanh tuần -->
        <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left" Content="‹" Width="36" Padding="0" Style="{StaticResource NutPhu}"
                       ToolTip="Tuần trước" AutomationProperties.Name="Tuần trước"
                       Command="{Binding TuanTruocCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding NhanTuan}" FontSize="15" FontWeight="SemiBold" Margin="12,0"
                       VerticalAlignment="Center" Foreground="{StaticResource MauChu}" />
            <ui:Button DockPanel.Dock="Left" Content="›" Width="36" Padding="0" Style="{StaticResource NutPhu}"
                       ToolTip="Tuần sau" AutomationProperties.Name="Tuần sau"
                       Command="{Binding TuanSauCommand}" />
            <ui:Button DockPanel.Dock="Left" Content="Tuần này" Margin="8,0,0,0" Style="{StaticResource NutPhu}"
                       Command="{Binding TuanNayCommand}" />

            <Border DockPanel.Dock="Right" Padding="10,6" CornerRadius="4" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource MauCanhBaoNen}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DuDinhMuc}" Value="True">
                                <Setter Property="Background" Value="{StaticResource MauOkNen}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding TomTatDinhMuc}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MauCanhBaoChu}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DuDinhMuc}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource MauOkChu}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DockPanel>

        <!-- Hộp thông báo: màu đổi theo LoaiThongBao (mặc định là lỗi) -->
        <Border Grid.Row="3" Margin="0,0,0,12" Padding="12,8" CornerRadius="4"
                Visibility="{Binding CoThongBao, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource MauLoiNen}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                            <Setter Property="Background" Value="{StaticResource MauOkNen}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                            <Setter Property="Background" Value="{StaticResource MauCanhBaoNen}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ThongBao}" FontSize="13" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MauLoiChu}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                                <Setter Property="Foreground" Value="{StaticResource MauOkChu}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                                <Setter Property="Foreground" Value="{StaticResource MauCanhBaoChu}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- ================= Lưới tuần ================= -->
            <Border Grid.Column="0" Style="{StaticResource The}" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="760">
                        <!-- Tiêu đề cột -->
                        <Grid MinHeight="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ca" FontSize="13" FontWeight="SemiBold" Padding="8,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource MauChuPhu}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding CacCotNgay}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2" Padding="4" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LaHomNay}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource MauChon}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Thu}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LaHomNay}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource MauNhan}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DaQua}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding NgayNgan}" FontSize="12" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource MauChuPhu}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Border Height="1" Background="{StaticResource MauVienBang}" />

                        <TextBlock Margin="8,16" Style="{StaticResource ChuPhu}" FontSize="13"
                                   Text="Chưa có ca nào đang sử dụng. Thêm ca ở màn Cấu hình hệ thống."
                                   Visibility="{Binding KhongCoCa, Converter={StaticResource BoolToVis}}" />

                        <!-- Các hàng ca -->
                        <ItemsControl ItemsSource="{Binding CacHangCa}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid MinHeight="96">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="8,8,4,8">
                                                <TextBlock Text="{Binding TenCa}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MauChu}" />
                                                <TextBlock Text="{Binding GioHienThi}" Style="{StaticResource ChuPhu}" />
                                                <TextBlock Text="Ngừng sử dụng" Style="{StaticResource ChuPhu}" FontStyle="Italic"
                                                           Visibility="{Binding NgungSuDung, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding CacO}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="7" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="2,4" Padding="4" CornerRadius="4">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DaQua}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.6" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <ItemsControl ItemsSource="{Binding CacThe}" Focusable="False">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="0,0,0,3" Padding="6,2,2,2" CornerRadius="4"
                                                                                    ToolTip="{Binding ChuThich}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="{StaticResource MauGroomerNen}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding LaLeTan}" Value="True">
                                                                                                <Setter Property="Background" Value="{StaticResource MauLeTanNen}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding DaNghiViec}" Value="True">
                                                                                                <Setter Property="Background" Value="{StaticResource MauCanhBaoNen}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <DockPanel>
                                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource NutXoaThe}"
                                                                                            AutomationProperties.Name="{Binding NhanNutXoa}"
                                                                                            ToolTip="{Binding NhanNutXoa}"
                                                                                            Visibility="{Binding XoaDuoc, Converter={StaticResource BoolToVis}}"
                                                                                            Command="{Binding DataContext.XoaLichCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                            CommandParameter="{Binding}" />
                                                                                    <TextBlock Text="{Binding TenHienThi}" FontSize="12" VerticalAlignment="Center"
                                                                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource MauChu}" />
                                                                                </DockPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <Border Padding="4,1" CornerRadius="3" HorizontalAlignment="Left"
                                                                        ToolTip="{Binding DinhMucChiTiet}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding CanCanhBao}" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource MauCanhBaoNen}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding DinhMucHienThi}" FontSize="11">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource MauOkChu}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding LechDinhMuc}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding CanCanhBao}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource MauCanhBaoChu}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource MauVienBang}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= Khung xếp lịch nhiều ngày ================= -->
            <Border Grid.Column="2" Style="{StaticResource The}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Xếp lịch nhiều ngày" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource MauChu}" />

                        <TextBlock Text="Nhân viên" Style="{StaticResource NhanO}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding DanhSachNhanVien}"
                                  SelectedItem="{Binding NhanVienChon, Mode=TwoWay}"
                                  DisplayMemberPath="HoTen" />

                        <TextBlock Text="Ca" Style="{StaticResource NhanO}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding DanhSachCa}"
                                  SelectedItem="{Binding CaChon, Mode=TwoWay}"
                                  DisplayMemberPath="TenCa" />

                        <TextBlock Text="Vị trí" Style="{StaticResource NhanO}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding DanhSachViTri}"
                                  SelectedItem="{Binding ViTriChon, Mode=TwoWay}" />

                        <TextBlock Text="Các ngày trong tuần" Style="{StaticResource NhanO}" />
                        <ItemsControl ItemsSource="{Binding CacNgayChon}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Thu}" MinWidth="0" Margin="0,0,0,4"
                                              ToolTip="{Binding ChuThich}"
                                              IsEnabled="{Binding CoTheChon}"
                                              IsChecked="{Binding DuocChon, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,8,0,12" Style="{StaticResource ChuPhu}"
                                   Text="Ngày nhân viên đã có lịch sẽ được bỏ qua và báo lại. Bấm × trên thẻ tên để xoá khỏi lịch." />

                        <ui:Button Content="Thêm vào lịch" HorizontalAlignment="Stretch" Style="{StaticResource NutChinh}"
                                   Command="{Binding ThemVaoLichCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Chú thích màu -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource MauLeTanNen}" Margin="0,0,6,0" />
            <TextBlock Text="Lễ tân" Style="{StaticResource ChuPhu}" FontSize="13" Margin="0,0,16,0" />
            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource MauGroomerNen}" Margin="0,0,6,0" />
            <TextBlock Text="Groomer" Style="{StaticResource ChuPhu}" FontSize="13" Margin="0,0,16,0" />
            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource MauCanhBaoNen}" Margin="0,0,6,0" />
            <TextBlock Text="Chưa đủ hoặc vượt định mức · nhân viên đã nghỉ việc" Style="{StaticResource ChuPhu}" FontSize="13" />
        </StackPanel>
    </Grid>
</UserControl>
