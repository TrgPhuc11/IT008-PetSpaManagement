<UserControl x:Class="SpaThuCung.Views.LichLamViecView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SpaThuCung.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Màu theo mẫu giao diện -->
        <SolidColorBrush x:Key="MauLeTanNen" Color="#E8EEF6" />
        <SolidColorBrush x:Key="MauLeTanVien" Color="#4A6FA0" />
        <SolidColorBrush x:Key="MauGroomerNen" Color="#E6F0DA" />
        <SolidColorBrush x:Key="MauGroomerVien" Color="#5A8A3A" />
        <SolidColorBrush x:Key="MauHangThieu" Color="#FFFBF4" />
        <SolidColorBrush x:Key="MauThanhChon" Color="#2B2520" />
        <SolidColorBrush x:Key="MauChuThanhChon" Color="#FFFDF9" />
        <SolidColorBrush x:Key="MauChipThieuVien" Color="#F3DE9C" />

        <!-- Nút chính (màu nhấn) và nút phụ, cùng kiểu với các màn khác -->
        <Style x:Key="NutChinh" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="{StaticResource MauNhan}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauNhan}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedForeground" Value="White" />
        </Style>
        <Style x:Key="NutPhu" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource MauNutPhu}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauChon}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauChon}" />
            <Setter Property="PressedForeground" Value="{StaticResource MauChu}" />
        </Style>

        <!-- Nút chế độ xem (Tuần | Tháng | Khoảng ngày): Tag = đang chọn -->
        <Style x:Key="NutCheDo" TargetType="ui:Button" BasedOn="{StaticResource NutPhu}">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{StaticResource MauChon}" />
                    <Setter Property="Foreground" Value="{StaticResource MauNhanDam}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="MouseOverBackground" Value="{StaticResource MauChon}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MauThe}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVienBang}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="ChuPhu" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
        </Style>

        <!-- Chip trạng thái ca ở hàng "Ca còn thiếu" -->
        <Style x:Key="ChipCa" TargetType="Button">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding GoiY}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding GoiY}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Vo" CornerRadius="3" Padding="4,3" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent">
                            <TextBlock x:Name="Chu" Text="{Binding Text}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MauOkChu}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Rong}" Value="False">
                                <Setter TargetName="Vo" Property="Padding" Value="0,2" />
                                <Setter TargetName="Chu" Property="HorizontalAlignment" Value="Center" />
                                <Setter TargetName="Chu" Property="FontSize" Value="10" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Loai}" Value="Thieu">
                                <Setter TargetName="Vo" Property="Background" Value="{StaticResource MauCanhBaoNen}" />
                                <Setter TargetName="Vo" Property="BorderBrush" Value="{StaticResource MauChipThieuVien}" />
                                <Setter TargetName="Chu" Property="Foreground" Value="{StaticResource MauCanhBaoChu}" />
                                <Setter TargetName="Chu" Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Loai}" Value="Thua">
                                <Setter TargetName="Vo" Property="Background" Value="{StaticResource MauLoiNen}" />
                                <Setter TargetName="Chu" Property="Foreground" Value="{StaticResource MauLoiChu}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DangChon}" Value="True">
                                <Setter TargetName="Vo" Property="BorderBrush" Value="{StaticResource MauNhan}" />
                                <Setter TargetName="Vo" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ô lịch: khối màu theo vị trí, viền trái đậm; chọn = viền nhấn; gợi ý = viền đứt nét -->
        <Style x:Key="OLich" TargetType="Button">
            <Setter Property="Width" Value="{Binding ChieuRongO}" />
            <Setter Property="Height" Value="{Binding ChieuCaoO}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding MoTaTruyCap}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ngoai" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent">
                            <Grid>
                                <Border CornerRadius="2" Background="{Binding Nen}"
                                        BorderBrush="{Binding VienTrai}" BorderThickness="3,0,0,0" />
                                <Rectangle x:Name="GoiYVien" Visibility="Collapsed" RadiusX="3" RadiusY="3"
                                           Stroke="{StaticResource MauNhan}" StrokeThickness="1" StrokeDashArray="3 2" />
                                <Rectangle x:Name="PhuChon" Visibility="Collapsed" Fill="#14A9481F" />
                                <StackPanel x:Name="Chu" VerticalAlignment="Center" Margin="9,0,4,0">
                                    <TextBlock Text="{Binding Dong1}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Chu}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="Dong2" Text="{Binding Dong2}" FontSize="10.5" Opacity="0.85"
                                               Foreground="{Binding Chu}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="Cong" Text="{Binding ChuCong}" FontSize="15" Opacity="0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource MauNhan}"
                                           Visibility="{Binding HienCong, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Rong}" Value="False">
                                <Setter TargetName="Chu" Property="HorizontalAlignment" Value="Center" />
                                <Setter TargetName="Chu" Property="Margin" Value="3,0,0,0" />
                                <!-- Ô thu gọn chỉ cao 30px: bỏ dòng 2 để ký hiệu ca nằm giữa ô -->
                                <Setter TargetName="Dong2" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DaQua}" Value="True">
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cong" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding GoiY}" Value="True">
                                <Setter TargetName="GoiYVien" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Cong" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DaChon}" Value="True">
                                <Setter TargetName="Ngoai" Property="BorderBrush" Value="{StaticResource MauNhan}" />
                                <Setter TargetName="PhuChon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Cong" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút tên nhân viên: bấm để chọn mọi ô trống chưa qua -->
        <Style x:Key="NutTenNhanVien" TargetType="Button">
            <Setter Property="Width" Value="180" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding MoTaTruyCap}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Nen" Background="Transparent" Padding="10,4" CornerRadius="4">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding HoTen}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource MauChu}" />
                                <TextBlock Text="{Binding PhuDe}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MauChuPhu}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Nen" Property="Background" Value="{StaticResource MauChon}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Lịch làm việc" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"
                   Foreground="{StaticResource MauChu}" />

        <!-- Thanh công cụ -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left" Content="‹" Width="36" Padding="0" Style="{StaticResource NutPhu}"
                       ToolTip="Lùi một kỳ" AutomationProperties.Name="Lùi một kỳ"
                       Command="{Binding KyTruocCommand}" />

            <TextBlock DockPanel.Dock="Left" Text="{Binding NhanKy}" FontSize="15" FontWeight="SemiBold" Margin="12,0"
                       VerticalAlignment="Center" Foreground="{StaticResource MauChu}"
                       Visibility="{Binding KhongPhaiKhoang, Converter={StaticResource BoolToVis}}" />

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"
                        Visibility="{Binding LaCheDoKhoang, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Từ" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource MauChu}" />
                <DatePicker Width="140" SelectedDate="{Binding TuNgayChon, Mode=TwoWay}"
                            AutomationProperties.Name="Từ ngày" />
                <TextBlock Text="đến" FontSize="13" VerticalAlignment="Center" Margin="10,0,6,0"
                           Foreground="{StaticResource MauChu}" />
                <DatePicker Width="140" SelectedDate="{Binding DenNgayChon, Mode=TwoWay}"
                            AutomationProperties.Name="Đến ngày" />
            </StackPanel>

            <ui:Button DockPanel.Dock="Left" Content="›" Width="36" Padding="0" Style="{StaticResource NutPhu}"
                       ToolTip="Tiến một kỳ" AutomationProperties.Name="Tiến một kỳ"
                       Command="{Binding KySauCommand}" />
            <ui:Button DockPanel.Dock="Left" Content="Hôm nay" Margin="8,0,0,0" Style="{StaticResource NutPhu}"
                       Command="{Binding HomNayCommand}" />

            <!-- Nhóm chế độ xem (ngoài cùng bên phải) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <ui:Button Content="Tuần" Style="{StaticResource NutCheDo}" Tag="{Binding LaCheDoTuan}"
                           Command="{Binding ChonCheDoTuanCommand}" />
                <ui:Button Content="Tháng" Style="{StaticResource NutCheDo}" Tag="{Binding LaCheDoThang}"
                           Command="{Binding ChonCheDoThangCommand}" />
                <ui:Button Content="Khoảng ngày" Style="{StaticResource NutCheDo}" Tag="{Binding LaCheDoKhoang}"
                           Command="{Binding ChonCheDoKhoangCommand}" />
            </StackPanel>

            <ui:Button DockPanel.Dock="Right" Content="Lặp lịch tuần" Margin="8,0,0,0" Style="{StaticResource NutPhu}"
                       ToolTipService.ShowOnDisabled="True"
                       ToolTip="Chép lịch tuần đang xem sang các tuần sau (chỉ ở chế độ Tuần)"
                       Command="{Binding LapLichTuanCommand}" />
            <ui:Button DockPanel.Dock="Right" Content="↶ Hoàn tác" Margin="8,0,0,0" Style="{StaticResource NutPhu}"
                       ToolTipService.ShowOnDisabled="True"
                       ToolTip="{Binding GoiYHoanTac}"
                       Command="{Binding HoanTacCommand}" />
        </DockPanel>

        <!-- Hộp thông báo: màu đổi theo LoaiThongBao (mặc định là lỗi) -->
        <Border Grid.Row="2" Margin="0,0,0,12" Padding="12,8" CornerRadius="4"
                Visibility="{Binding CoThongBao, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource MauLoiNen}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                            <Setter Property="Background" Value="{StaticResource MauOkNen}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                            <Setter Property="Background" Value="{StaticResource MauCanhBaoNen}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ThongBao}" FontSize="13" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MauLoiChu}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                                <Setter Property="Foreground" Value="{StaticResource MauOkChu}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                                <Setter Property="Foreground" Value="{StaticResource MauCanhBaoChu}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ================= Lưới ================= -->
        <Border Grid.Row="3" Style="{StaticResource The}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Hàng tiêu đề ngày (không bấm được) -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="180" Text="Nhân viên" FontSize="13" FontWeight="SemiBold" Padding="10,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource MauChuPhu}" />
                        <ItemsControl ItemsSource="{Binding CacCotNgay}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding ChieuRongCot}" Padding="0,6" CornerRadius="4,4,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LaHomNay}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource MauChon}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Thu}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MauChu}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DaQua}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LaHomNay}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource MauNhan}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding NgayText}" HorizontalAlignment="Center" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LaHomNay}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource MauNhan}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Hàng "Ca còn thiếu" -->
                    <Border Background="{StaticResource MauHangThieu}" CornerRadius="4" Margin="0,2,0,4"
                            BorderBrush="{StaticResource MauVienBang}" BorderThickness="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="180" Text="Ca còn thiếu" FontSize="13" FontWeight="SemiBold" Padding="10,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource MauCanhBaoChu}" />
                            <ItemsControl ItemsSource="{Binding CacCotThieu}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ChieuRongCot}" MinHeight="26" Padding="0,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DaQua}" Value="True">
                                                            <Setter Property="Background" Value="#F3EDE3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ItemsControl ItemsSource="{Binding CacChip}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ChipCa}"
                                                                Command="{Binding ChonCommand}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Các hàng nhân viên, chia nhóm theo vị trí thường làm -->
                    <ItemsControl ItemsSource="{Binding CacHang}" Focusable="False">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type vm:TieuDeNhomLichViewModel}">
                                <TextBlock Text="{Binding Ten}" FontSize="12" FontWeight="SemiBold" Margin="10,12,0,4"
                                           Foreground="{StaticResource MauChuPhu}" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:HangNhanVienViewModel}">
                                <Border BorderBrush="{StaticResource MauVienBang}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource NutTenNhanVien}"
                                                Command="{Binding ChonCaHangCommand}"
                                                VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{Binding CacO}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource OLich}"
                                                            Command="{Binding ChonCommand}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= Thanh phân công (khi có ô được chọn) ================= -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="14,10" CornerRadius="8"
                Background="{StaticResource MauThanhChon}"
                Visibility="{Binding CoChon, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding TieuDeChon}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource MauChuThanhChon}" />
                    <TextBlock Text="{Binding PhuDeChon}" FontSize="12" Opacity="0.75"
                               Foreground="{StaticResource MauChuThanhChon}" />
                </StackPanel>

                <ui:Button DockPanel.Dock="Right" Content="Bỏ chọn" Margin="8,0,0,0" Height="36"
                           Appearance="Transparent"
                           Foreground="{StaticResource MauChuThanhChon}"
                           Command="{Binding BoChonCommand}" />
                <ui:Button DockPanel.Dock="Right" Content="Gỡ ca" Margin="8,0,0,0" Height="36"
                           BorderBrush="#E8A39B" Foreground="#F6C9C2" Background="Transparent"
                           MouseOverBackground="#33E8A39B" MouseOverBorderBrush="#E8A39B"
                           Command="{Binding GoCaCommand}" />
                <ui:Button DockPanel.Dock="Right" Content="{Binding NhanPhanCong}" Margin="8,0,0,0"
                           Style="{StaticResource NutChinh}"
                           Command="{Binding PhanCongCommand}" />
                <ComboBox DockPanel.Dock="Right" Width="190" Margin="8,0,0,0" VerticalAlignment="Center"
                          ItemsSource="{Binding CacViTriChon}"
                          SelectedItem="{Binding ViTriDangChon, Mode=TwoWay}"
                          DisplayMemberPath="HienThi"
                          AutomationProperties.Name="Vị trí" />
                <ComboBox DockPanel.Dock="Right" Width="230" Margin="8,0,0,0" VerticalAlignment="Center"
                          ItemsSource="{Binding CacCaChon}"
                          SelectedItem="{Binding CaDangChon, Mode=TwoWay}"
                          DisplayMemberPath="HienThi"
                          AutomationProperties.Name="Ca" />
            </DockPanel>
        </Border>

        <!-- Chú thích và gợi ý thao tác -->
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                        Background="{StaticResource MauLeTanNen}" BorderBrush="{StaticResource MauLeTanVien}"
                        BorderThickness="3,0,0,0" />
                <TextBlock Text="Lễ tân" Margin="6,0,18,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource MauChuPhu}" />
                <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                        Background="{StaticResource MauGroomerNen}" BorderBrush="{StaticResource MauGroomerVien}"
                        BorderThickness="3,0,0,0" />
                <TextBlock Text="Groomer" Margin="6,0,18,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource MauChuPhu}" />
                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" VerticalAlignment="Center"
                           Fill="#FFF7EE" Stroke="{StaticResource MauNhan}" StrokeThickness="1" StrokeDashArray="3 2" />
                <TextBlock Text="Ô gợi ý (người rảnh cho ca thiếu)" Margin="6,0,0,0" FontSize="12"
                           VerticalAlignment="Center" Foreground="{StaticResource MauChuPhu}" />
            </StackPanel>
            <TextBlock Text="{Binding HuongDan}" Style="{StaticResource ChuPhu}" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
