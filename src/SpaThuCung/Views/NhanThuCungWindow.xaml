<ui:FluentWindow x:Class="SpaThuCung.Views.NhanThuCungWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Nhận thú cưng"
                 Width="620" SizeToContent="Height" MaxHeight="760"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource MauNen}"
                 Foreground="{StaticResource MauChu}"
                 FontFamily="Segoe UI">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Nhận thú cưng" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding TieuDe}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource MauChu}" />
                <TextBlock Text="{Binding MoTa}" Margin="0,6,0,12" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource MauChuPhu}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Cân nặng thực tế (kg)" FontSize="13" Margin="0,0,0,6" Foreground="{StaticResource MauChu}" />
                    <TextBox Text="{Binding CanNang, UpdateSourceTrigger=PropertyChanged}" Height="36" Width="160"
                             HorizontalAlignment="Left" />

                    <TextBlock Text="Dịch vụ (giá, thời lượng tra lại theo cân nặng mới)" FontSize="13" Margin="0,14,0,6"
                               Foreground="{StaticResource MauChu}" />
                    <ItemsControl ItemsSource="{Binding CacDong}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" CornerRadius="6"
                                        Background="{StaticResource MauThe}"
                                        BorderBrush="{StaticResource MauVienBang}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TenDv}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource MauChu}" />
                                        <TextBlock FontSize="13" Foreground="{StaticResource MauChuPhu}" Margin="0,2,0,0">
                                            <Run Text="Trước: " /><Run Text="{Binding CuHienThi, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="13" Foreground="{StaticResource MauChu}" Margin="0,2,0,0">
                                            <Run Text="Nay: " /><Run Text="{Binding MoiHienThi, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Text="Chưa có giá cho cân nặng này trong bảng giá, hãy nhập tay kèm lý do."
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{StaticResource MauCanhBaoChu}"
                                                   Visibility="{Binding KhongCoGia, Converter={StaticResource BoolToVis}}" />
                                        <CheckBox Content="Nhập tay giá, thời lượng" Margin="0,6,0,0"
                                                  IsChecked="{Binding NhapTay, Mode=TwoWay}"
                                                  IsEnabled="{Binding DuocTichNhapTay}" />
                                        <Grid Margin="0,6,0,0" Visibility="{Binding NhapTay, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ui:TextBox Grid.Row="0" Grid.Column="0" Height="34" PlaceholderText="Giá (VNĐ)"
                                                     Text="{Binding DonGiaNhap, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:TextBox Grid.Row="0" Grid.Column="2" Height="34" PlaceholderText="Phút"
                                                     Text="{Binding ThoiLuongNhap, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="34" Margin="0,6,0,0" PlaceholderText="Lý do (vượt cân, trường hợp đặc biệt...)"
                                                     Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock FontSize="14" Margin="0,4,0,0" Foreground="{StaticResource MauChu}">
                        <Run Text="Tổng trước: " /><Run Text="{Binding TongCuHienThi, Mode=OneWay}" />
                        <Run Text="   Tổng nay: " /><Run Text="{Binding TongMoiHienThi, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <CheckBox Content="Khách đồng ý chi phí mới" Margin="0,8,0,0" IsChecked="{Binding KhachDongY, Mode=TwoWay}"
                              Visibility="{Binding TongDoi, Converter={StaticResource BoolToVis}}" />
                    <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="4" Background="{StaticResource MauCanhBaoNen}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanhBaoGio}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CanhBaoGio}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource MauCanhBaoChu}" />
                    </Border>

                    <TextBlock Text="Groomer phụ trách (có lịch ca hiện tại)" FontSize="13" Margin="0,14,0,6"
                               Foreground="{StaticResource MauChu}" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CacGroomer}"
                              SelectedItem="{Binding GroomerChon, Mode=TwoWay}" DisplayMemberPath="HienThi" />

                    <TextBlock Text="Lồng" FontSize="13" Margin="0,14,0,6" Foreground="{StaticResource MauChu}" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CacLong}"
                              SelectedItem="{Binding LongChon, Mode=TwoWay}" DisplayMemberPath="HienThi" />
                    <TextBlock Text="{Binding GhiChuLong}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MauChuPhu}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8" CornerRadius="4"
                        Background="{StaticResource MauLoiNen}"
                        Visibility="{Binding CoLoi, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Loi}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource MauLoiChu}" />
                </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Huỷ" Height="36" MinWidth="80" Margin="0,0,8,0"
                           IsCancel="True"
                           Background="{StaticResource MauNutPhu}"
                           BorderBrush="{StaticResource MauVien}"
                           Foreground="{StaticResource MauChu}"
                           MouseOverBackground="{StaticResource MauChon}"
                           MouseOverBorderBrush="{StaticResource MauVien}"
                           PressedBackground="{StaticResource MauChon}"
                           PressedForeground="{StaticResource MauChu}"
                           Command="{Binding HuyCommand}" />
                <ui:Button Content="Xác nhận nhận thú cưng" Height="36" MinWidth="140"
                           IsDefault="True"
                           Appearance="Primary"
                           Background="{StaticResource MauNhan}"
                           BorderBrush="{StaticResource MauNhan}"
                           Foreground="White"
                           MouseOverBackground="{StaticResource MauNhanDam}"
                           MouseOverBorderBrush="{StaticResource MauNhanDam}"
                           PressedBackground="{StaticResource MauNhanDam}"
                           PressedForeground="White"
                           Command="{Binding XacNhanCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
