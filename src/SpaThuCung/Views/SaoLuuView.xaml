<UserControl x:Class="SpaThuCung.Views.SaoLuuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Nút chính (màu nhấn) và nút phụ, cùng kiểu với các màn khác -->
        <Style x:Key="NutChinh" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="{StaticResource MauNhan}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauNhan}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauNhanDam}" />
            <Setter Property="PressedForeground" Value="White" />
        </Style>
        <Style x:Key="NutPhu" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource MauNutPhu}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Setter Property="MouseOverBackground" Value="{StaticResource MauChon}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="PressedBackground" Value="{StaticResource MauChon}" />
            <Setter Property="PressedForeground" Value="{StaticResource MauChu}" />
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MauThe}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVienBang}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="TieuDeThe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
        </Style>
        <Style x:Key="NhanO" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
        </Style>
        <Style x:Key="ChuPhu" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
        </Style>

        <Style x:Key="TieuDeCot" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
        </Style>
        <Style x:Key="TieuDeCotSo" TargetType="TextBlock" BasedOn="{StaticResource TieuDeCot}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="ChuO" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
        </Style>
        <Style x:Key="ChuOSo" TargetType="TextBlock" BasedOn="{StaticResource ChuO}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sao lưu và phục hồi dữ liệu" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource MauChu}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,16" FontSize="14" TextWrapping="Wrap"
                   Foreground="{StaticResource MauChuPhu}"
                   Text="Hệ thống chạy trên một máy, nên hãy sao lưu thường xuyên ra ổ đĩa ngoài hoặc USB. Bản sao lưu gồm cơ sở dữ liệu và thư mục ảnh thú cưng." />

        <!-- Đang sao lưu / phục hồi -->
        <Border Grid.Row="2" Margin="0,0,0,12" Padding="12,8" CornerRadius="4"
                Background="{StaticResource MauChon}"
                Visibility="{Binding DangXuLy, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ChuDangXuLy}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource MauChu}" />
            </StackPanel>
        </Border>

        <!-- Hộp thông báo: màu đổi theo LoaiThongBao (mặc định là lỗi) -->
        <Border Grid.Row="3" Margin="0,0,0,12" Padding="12,8" CornerRadius="4"
                Visibility="{Binding CoThongBao, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource MauLoiNen}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                            <Setter Property="Background" Value="{StaticResource MauOkNen}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                            <Setter Property="Background" Value="{StaticResource MauCanhBaoNen}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ThongBao}" FontSize="13" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MauLoiChu}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="ThanhCong">
                                <Setter Property="Foreground" Value="{StaticResource MauOkChu}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LoaiThongBao}" Value="CanhBao">
                                <Setter Property="Foreground" Value="{StaticResource MauCanhBaoChu}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ================= Sao lưu ================= -->
                    <Border Grid.Column="0" Style="{StaticResource The}">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="20" Foreground="{StaticResource MauNhan}" />
                                <TextBlock Text="Sao lưu" Style="{StaticResource TieuDeThe}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ChuPhu}" Margin="0,0,0,14"
                                       Text="Tạo một thư mục mới trong nơi lưu, gồm tệp cơ sở dữ liệu SpaThuCung.bak và bản chép thư mục ảnh. Các bản cũ được giữ lại." />

                            <TextBlock DockPanel.Dock="Top" Text="Nơi lưu" Style="{StaticResource NhanO}" />
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" IsReadOnly="True" PlaceholderText="Chưa chọn (nên chọn ổ đĩa ngoài hoặc USB)"
                                            Text="{Binding NoiLuu, Mode=OneWay}" ToolTip="{Binding NoiLuu}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Chọn thư mục…"
                                           Style="{StaticResource NutPhu}" Icon="{ui:SymbolIcon FolderOpen24}"
                                           Command="{Binding ChonNoiLuuCommand}" />
                            </Grid>

                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ChuPhu}" Margin="0,0,0,14"
                                       Text="{Binding LanSaoLuuGanNhat}" />

                            <ui:Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" MinWidth="140"
                                       Content="Sao lưu ngay" Style="{StaticResource NutChinh}"
                                       Icon="{ui:SymbolIcon Save24}"
                                       Command="{Binding SaoLuuCommand}" />
                        </DockPanel>
                    </Border>

                    <!-- ================= Phục hồi ================= -->
                    <Border Grid.Column="2" Style="{StaticResource The}">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="20" Foreground="{StaticResource MauNhan}" />
                                <TextBlock Text="Phục hồi" Style="{StaticResource TieuDeThe}" />
                            </StackPanel>

                            <!-- Cảnh báo ghi đè -->
                            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="10,8" CornerRadius="4"
                                    Background="{StaticResource MauCanhBaoNen}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="18" VerticalAlignment="Top" Margin="0,1,8,0"
                                                   Foreground="{StaticResource MauCanhBaoChu}" />
                                    <TextBlock FontSize="13" TextWrapping="Wrap" MaxWidth="420"
                                               Foreground="{StaticResource MauCanhBaoChu}"
                                               Text="Phục hồi ghi đè toàn bộ dữ liệu hiện tại và thư mục ảnh bằng bản sao lưu; dữ liệu nhập sau lúc sao lưu sẽ mất. Phục hồi xong phải đăng nhập lại." />
                                </StackPanel>
                            </Border>

                            <TextBlock DockPanel.Dock="Top" Text="Bản sẽ phục hồi" Style="{StaticResource NhanO}" />
                            <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10,8" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{StaticResource MauVien}"
                                    Background="{StaticResource MauNutPhu}">
                                <TextBlock Text="{Binding ThongTinBanDaChon}" FontSize="13" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoBanDaChon}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                <ui:Button MinWidth="140" Content="Phục hồi…" Style="{StaticResource NutChinh}"
                                           Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                           Command="{Binding PhucHoiCommand}" />
                                <ui:Button Margin="8,0,0,0" Content="Chọn tệp .bak khác…" Style="{StaticResource NutPhu}"
                                           Icon="{ui:SymbolIcon DocumentArrowUp24}"
                                           Command="{Binding ChonTepPhucHoiCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ================= Các bản sao lưu ở nơi lưu ================= -->
                <Border Style="{StaticResource The}" Margin="0,16,0,0" Padding="6,10">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="10,0,4,8">
                            <ui:Button DockPanel.Dock="Right" Content="Tải lại" Height="32" Style="{StaticResource NutPhu}"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Command="{Binding TaiLaiDanhSachCommand}" />
                            <StackPanel>
                                <TextBlock Text="Các bản sao lưu ở nơi lưu" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource MauChu}" />
                                <TextBlock Text="{Binding TomTatDanhSach}" Style="{StaticResource ChuPhu}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Visibility="{Binding CoBanNao, Converter={StaticResource BoolToVis}}">
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" MinWidth="140" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="2*" MinWidth="160" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Thời gian" Style="{StaticResource TieuDeCot}" />
                                <TextBlock Grid.Column="1" Text="Người sao lưu" Style="{StaticResource TieuDeCot}" />
                                <TextBlock Grid.Column="2" Text="Số ảnh" Style="{StaticResource TieuDeCotSo}" />
                                <TextBlock Grid.Column="3" Text="Dung lượng" Style="{StaticResource TieuDeCotSo}" />
                                <TextBlock Grid.Column="4" Text="Thư mục" Style="{StaticResource TieuDeCot}" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource MauVienBang}" />

                            <ItemsControl ItemsSource="{Binding DanhSachBan}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="42">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" MinWidth="140" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="2*" MinWidth="160" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ThoiGianHienThi}" FontWeight="SemiBold" Style="{StaticResource ChuO}" />
                                            <TextBlock Grid.Column="1" Text="{Binding NguoiHienThi}" Style="{StaticResource ChuO}" />
                                            <TextBlock Grid.Column="2" Text="{Binding SoAnhHienThi}" Style="{StaticResource ChuOSo}" />
                                            <TextBlock Grid.Column="3" Text="{Binding DungLuongHienThi}" Style="{StaticResource ChuOSo}" />
                                            <TextBlock Grid.Column="4" Text="{Binding TenThuMuc}" ToolTip="{Binding Ban.ThuMuc}"
                                                       Style="{StaticResource ChuO}" />
                                            <ui:Button Grid.Column="5" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                       Content="Chọn để phục hồi" Height="32" Style="{StaticResource NutPhu}"
                                                       Command="{Binding DataContext.ChonBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
