<ui:FluentWindow x:Class="SpaThuCung.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SpaThuCung.ViewModels"
                 xmlns:v="clr-namespace:SpaThuCung.Views"
                 Title="Spa thú cưng"
                 Width="1280" Height="800"
                 MinWidth="1024" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource MauNen}"
                 Foreground="{StaticResource MauChu}"
                 FontFamily="Segoe UI">

    <ui:FluentWindow.Resources>
        <!-- Ghép ViewModel với View của màn hình -->
        <DataTemplate DataType="{x:Type vm:TrangChuViewModel}">
            <v:TrangChuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NhanVienViewModel}">
            <v:NhanVienView />
        </DataTemplate>

        <SolidColorBrush x:Key="MauRoChuotMenu" Color="#F9EFE5" />

        <!-- Mục menu trái. Dòng tiêu đề nhóm (LaTieuDe) dùng template riêng và không chọn được. -->
        <Style x:Key="MucMenuStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Vo" MinHeight="40" Margin="0,2,0,0" Padding="12,10"
                                CornerRadius="4" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Vo" Property="Background" Value="{StaticResource MauRoChuotMenu}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Vo" Property="Background" Value="{StaticResource MauChon}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MauNhan}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <DataTrigger Binding="{Binding LaTieuDe}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter Margin="12,14,12,4" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Spa thú cưng" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu trái -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="12,0,12,16">
                    <TextBlock Text="{Binding HoTen}" FontSize="18" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MauChu}" />
                    <TextBlock Text="{Binding VaiTro}" FontSize="14" Margin="0,2,0,0"
                               Foreground="{StaticResource MauChuPhu}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding DanhSachMenu}"
                         SelectedItem="{Binding MucDangChon, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource MucMenuStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TieuDe}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:Button Grid.Row="2" Content="Đăng xuất" Height="40"
                           HorizontalAlignment="Stretch"
                           Background="{StaticResource MauNutPhu}"
                           BorderBrush="{StaticResource MauVien}"
                           Foreground="{StaticResource MauChu}"
                           MouseOverBackground="{StaticResource MauChon}"
                           MouseOverBorderBrush="{StaticResource MauVien}"
                           PressedBackground="{StaticResource MauChon}"
                           PressedForeground="{StaticResource MauChu}"
                           Command="{Binding DangXuatCommand}" />
            </Grid>

            <!-- Vùng nội dung: View của màn hình hiện tại -->
            <ContentControl Grid.Column="2" Content="{Binding ManHinhHienTai}"
                            IsTabStop="False" />
        </Grid>
    </Grid>
</ui:FluentWindow>
