<ui:FluentWindow x:Class="SpaThuCung.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SpaThuCung.ViewModels"
                 xmlns:v="clr-namespace:SpaThuCung.Views"
                 Title="Spa thú cưng"
                 Width="1280" Height="800"
                 MinWidth="1024" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource MauNen}"
                 Foreground="{StaticResource MauChu}"
                 FontFamily="Segoe UI">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Ghép ViewModel với View của màn hình -->
        <DataTemplate DataType="{x:Type vm:TrangChuViewModel}">
            <v:TrangChuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NhanVienViewModel}">
            <v:NhanVienView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DichVuViewModel}">
            <v:DichVuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LichLamViecViewModel}">
            <v:LichLamViecView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CauHinhViewModel}">
            <v:CauHinhView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KhachHangViewModel}">
            <v:KhachHangView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThuCungViewModel}">
            <v:ThuCungView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThongKeViewModel}">
            <v:ThongKeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SaoLuuViewModel}">
            <v:SaoLuuView />
        </DataTemplate>

        <SolidColorBrush x:Key="MauRoChuotMenu" Color="#F9EFE5" />

        <!-- Liên kết chữ (Đổi mật khẩu): màu nhấn, đậm hơn khi rê chuột -->
        <Style x:Key="LienKet" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource MauNhan}" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MauNhanDam}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mục menu trái. Dòng tiêu đề nhóm (LaTieuDe) dùng template riêng và không chọn được. -->
        <Style x:Key="MucMenuStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Vo" MinHeight="40" Margin="0,2,0,0" Padding="12,10"
                                CornerRadius="4" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Vo" Property="Background" Value="{StaticResource MauRoChuotMenu}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Vo" Property="Background" Value="{StaticResource MauChon}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MauNhan}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <DataTrigger Binding="{Binding LaTieuDe}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter Margin="12,14,12,4" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Spa thú cưng" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ChieuRongMenu}" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu trái -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Margin="12,0,44,0"
                                Visibility="{Binding MenuMoRong, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding HoTen}" FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MauChu}" />
                        <TextBlock FontSize="14" Margin="0,2,0,0" Foreground="{StaticResource MauChuPhu}">
                            <Run Text="{Binding VaiTro, Mode=OneWay}" /><Run Text=" · " /><Hyperlink Style="{StaticResource LienKet}" Command="{Binding DoiMatKhauCommand}">Đổi mật khẩu</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <ui:Button Width="36" Height="36" Padding="0"
                               VerticalAlignment="Top"
                               Appearance="Transparent"
                               Foreground="{StaticResource MauChuPhu}"
                               MouseOverBackground="{StaticResource MauChon}"
                               PressedBackground="{StaticResource MauChon}"
                               Icon="{ui:SymbolIcon PanelLeft24}"
                               ToolTip="Thu gọn / mở rộng menu"
                               AutomationProperties.Name="Thu gọn hoặc mở rộng menu"
                               Command="{Binding DoiTrangThaiMenuCommand}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MenuThuGon}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>

                <ListBox Grid.Row="1"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding DanhSachMenu}"
                         SelectedItem="{Binding MucDangChon, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource MucMenuStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Mục thường: icon + tên; thu gọn thì chỉ icon, tên hiện ở ToolTip -->
                                <Grid x:Name="Dong" ToolTip="{Binding TieuDe}"
                                      ToolTipService.IsEnabled="{Binding DataContext.MenuThuGon, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon x:Name="BieuTuong" Grid.Column="0" Symbol="{Binding Icon}" FontSize="20"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Chu" Grid.Column="1" Text="{Binding TieuDe}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- Nhãn nhóm: thu gọn thì thành đường kẻ -->
                                <StackPanel x:Name="Nhom" Visibility="Collapsed">
                                    <TextBlock x:Name="NhanNhom" Text="{Binding TieuDe}" />
                                    <Border x:Name="DuongKe" Height="1" Margin="0,8,0,0" Visibility="Collapsed"
                                            Background="{StaticResource MauVien}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding LaTieuDe}" Value="True">
                                    <Setter TargetName="Dong" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Nhom" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.MenuThuGon, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                    <Setter TargetName="Chu" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="BieuTuong" Property="Margin" Value="0" />
                                    <Setter TargetName="Dong" Property="HorizontalAlignment" Value="Center" />
                                    <Setter TargetName="NhanNhom" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="DuongKe" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:Button Grid.Row="2" Height="40" Padding="0"
                           HorizontalAlignment="Stretch"
                           ToolTip="Đăng xuất"
                           ToolTipService.IsEnabled="{Binding MenuThuGon}"
                           AutomationProperties.Name="Đăng xuất"
                           Background="{StaticResource MauNutPhu}"
                           BorderBrush="{StaticResource MauVien}"
                           Foreground="{StaticResource MauChu}"
                           MouseOverBackground="{StaticResource MauChon}"
                           MouseOverBorderBrush="{StaticResource MauVien}"
                           PressedBackground="{StaticResource MauChon}"
                           PressedForeground="{StaticResource MauChu}"
                           Command="{Binding DangXuatCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="SignOut24" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Text="Đăng xuất" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding MenuMoRong, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- Vùng nội dung: View của màn hình hiện tại -->
            <ContentControl Grid.Column="2" Content="{Binding ManHinhHienTai}"
                            IsTabStop="False" />
        </Grid>
    </Grid>
</ui:FluentWindow>
