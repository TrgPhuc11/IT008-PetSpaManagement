<ui:FluentWindow x:Class="SpaThuCung.Views.LapLichTuanWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Lặp lịch tuần"
                 Width="480" SizeToContent="Height" MaxHeight="680"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource MauNen}"
                 Foreground="{StaticResource MauChu}"
                 FontFamily="Segoe UI">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Lặp lịch tuần" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Lặp lịch tuần" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource MauChu}" />
            <TextBlock Grid.Row="1" Text="{Binding Nguon}" Margin="0,4,0,12" FontSize="14"
                       TextWrapping="Wrap" Foreground="{StaticResource MauChuPhu}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Text="Chép sang" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource MauChu}" />
                <ComboBox Width="90" VerticalAlignment="Center"
                          ItemsSource="{Binding CacSoTuan}"
                          SelectedItem="{Binding SoTuan, Mode=TwoWay}" />
                <TextBlock Text="tuần tiếp theo," FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{StaticResource MauChu}" />
                <TextBlock Text="{Binding DenNgayText}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{StaticResource MauChuPhu}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Nhân viên" FontSize="13" Margin="0,16,0,6"
                       Foreground="{StaticResource MauChu}" />

            <Border Grid.Row="4" CornerRadius="6" Padding="4"
                    Background="{StaticResource MauThe}"
                    BorderBrush="{StaticResource MauVienBang}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NhanVien}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="8,4" IsChecked="{Binding Bat, Mode=TwoWay}"
                                          IsEnabled="{Binding CoTheChon}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding HoTen}" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding GhiChu}" FontSize="12" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MauChuPhu}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="5" Margin="0,16,0,0" Padding="12,8" CornerRadius="4"
                    Background="{StaticResource MauChon}">
                <StackPanel>
                    <TextBlock Text="{Binding TomTatChinh}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource MauChu}" />
                    <TextBlock Text="{Binding TomTatBoQua}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource MauChuPhu}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Margin="0,12,0,0" Padding="12,8" CornerRadius="4"
                    Background="{StaticResource MauLoiNen}"
                    Visibility="{Binding CoLoi, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ThongBaoLoi}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource MauLoiChu}" />
            </Border>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Huỷ" Height="36" MinWidth="80" Margin="0,0,8,0"
                           IsCancel="True"
                           Background="{StaticResource MauNutPhu}"
                           BorderBrush="{StaticResource MauVien}"
                           Foreground="{StaticResource MauChu}"
                           MouseOverBackground="{StaticResource MauChon}"
                           MouseOverBorderBrush="{StaticResource MauVien}"
                           PressedBackground="{StaticResource MauChon}"
                           PressedForeground="{StaticResource MauChu}"
                           Command="{Binding HuyCommand}" />
                <ui:Button Content="{Binding ChuNutLap}" Height="36" MinWidth="140"
                           IsDefault="True"
                           Appearance="Primary"
                           Background="{StaticResource MauNhan}"
                           BorderBrush="{StaticResource MauNhan}"
                           Foreground="White"
                           MouseOverBackground="{StaticResource MauNhanDam}"
                           MouseOverBorderBrush="{StaticResource MauNhanDam}"
                           PressedBackground="{StaticResource MauNhanDam}"
                           PressedForeground="White"
                           Command="{Binding LapCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
