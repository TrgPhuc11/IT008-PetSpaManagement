<ui:FluentWindow x:Class="SpaThuCung.Views.DoiLongWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Đổi lồng"
                 Width="460" SizeToContent="Height" MaxHeight="760"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource MauNen}"
                 Foreground="{StaticResource MauChu}"
                 FontFamily="Segoe UI">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Đổi lồng" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding TieuDe}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource MauChu}" />
            <TextBlock Grid.Row="1" Text="{Binding MoTa}" Margin="0,6,0,12" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource MauChuPhu}" />
            <ComboBox Grid.Row="2" HorizontalAlignment="Stretch" ItemsSource="{Binding CacLong}"
                      SelectedItem="{Binding LongChon, Mode=TwoWay}" DisplayMemberPath="HienThi" />

            <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,8" CornerRadius="4"
                        Background="{StaticResource MauLoiNen}"
                        Visibility="{Binding CoLoi, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Loi}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource MauLoiChu}" />
                </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Huỷ" Height="36" MinWidth="80" Margin="0,0,8,0"
                           IsCancel="True"
                           Background="{StaticResource MauNutPhu}"
                           BorderBrush="{StaticResource MauVien}"
                           Foreground="{StaticResource MauChu}"
                           MouseOverBackground="{StaticResource MauChon}"
                           MouseOverBorderBrush="{StaticResource MauVien}"
                           PressedBackground="{StaticResource MauChon}"
                           PressedForeground="{StaticResource MauChu}"
                           Command="{Binding HuyCommand}" />
                <ui:Button Content="Đổi lồng" Height="36" MinWidth="140"
                           IsDefault="True"
                           Appearance="Primary"
                           Background="{StaticResource MauNhan}"
                           BorderBrush="{StaticResource MauNhan}"
                           Foreground="White"
                           MouseOverBackground="{StaticResource MauNhanDam}"
                           MouseOverBorderBrush="{StaticResource MauNhanDam}"
                           PressedBackground="{StaticResource MauNhanDam}"
                           PressedForeground="White"
                           Command="{Binding XacNhanCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
