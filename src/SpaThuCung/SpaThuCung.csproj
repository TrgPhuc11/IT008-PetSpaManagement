<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpaThuCung</RootNamespace>
    <AssemblyName>SpaThuCung</AssemblyName>
    <!-- LiveCharts2 kéo theo SkiaSharp.Views.WPF/OpenTK chỉ đóng gói cho .NET Framework nhưng chạy được trên WPF .NET -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Biểu đồ doanh thu (Thống kê doanh thu) -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Script tạo CSDL dùng chung với file chạy tay trong SSMS; chạy theo thứ tự tên -->
    <EmbeddedResource Include="..\..\Database\01_TaoCSDL_NhanVien.sql" LogicalName="SpaThuCung.Sql.01_TaoCSDL_NhanVien" />
    <EmbeddedResource Include="..\..\Database\02_TaoBang_DichVu_BangGia.sql" LogicalName="SpaThuCung.Sql.02_TaoBang_DichVu_BangGia" />
    <EmbeddedResource Include="..\..\Database\03_TaoBang_CauHinh_CaLamViec.sql" LogicalName="SpaThuCung.Sql.03_TaoBang_CauHinh_CaLamViec" />
    <EmbeddedResource Include="..\..\Database\04_TaoBang_LichLamViec.sql" LogicalName="SpaThuCung.Sql.04_TaoBang_LichLamViec" />
    <EmbeddedResource Include="..\..\Database\05_TaoBang_PhieuDichVu.sql" LogicalName="SpaThuCung.Sql.05_TaoBang_PhieuDichVu" />
    <EmbeddedResource Include="..\..\Database\06_TaoBang_NhatKy_HinhAnh_Long.sql" LogicalName="SpaThuCung.Sql.06_TaoBang_NhatKy_HinhAnh_Long" />
  </ItemGroup>

</Project>
